package pumpkin:plugin@1.0.0;

interface sounds {
  enum sound-category {
    master,
    music,
    records,
    weather,
    blocks,
    hostile,
    neutral,
    players,
    ambient,
    voice,
    ui,
  }
  /// A sound identifier, as a registry key such as "entity.pig.hurt" or
  /// "minecraft:block.anvil.land".
  ///
  /// This was a generated enum of 1969 cases. It is a `string` because the case list
  /// grows with every Minecraft version, and a WIT enum typechecks by exact case count,
  /// order and name: adding one sound changed the type identity and invalidated every
  /// previously compiled plugin. See the discussion in issue #43.
  ///
  /// Nothing is lost at runtime. Every host implementation already converted this enum
  /// straight back into a string and resolved it by name, so the enum bought compile-time
  /// exhaustiveness at the cost of a rebuild on every game update.
  type sound = string;
}

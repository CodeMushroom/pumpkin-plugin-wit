package pumpkin:plugin@1.0.0;

interface entity-types {
  /// An entity type, as a registry key such as "pig" or "minecraft:zombie".
  ///
  /// This was a generated enum of 158 cases. It is a `string` for the same reason as
  /// `sounds.sound`: the case list grows with every Minecraft version, and a WIT enum
  /// typechecks by exact case count, order and name, so one new mob invalidated every
  /// compiled plugin.
  ///
  /// It also removes an `unsafe` block. The host used to binary-search the name in
  /// `EntityType::ALL` and `transmute` the resulting index into this enum, on the
  /// stated invariant that the enum was "generated with variants matching
  /// EntityType::ALL in alphabetical order" - an invariant spanning two repositories
  /// that nothing enforced, with an `index as u8` that would silently truncate past 255
  /// entries.
  ///
  /// The interface already used strings for this concept elsewhere (`event.entity-type`,
  /// `text.hover-show-entity`), so this also removes a second representation of one thing.
  type entity-type = string;
}
